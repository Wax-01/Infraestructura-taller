<mxfile host="app.diagrams.net">
  <diagram name="Mapa de Infraestructura AS-IS - Encuesta de Autoevaluacion" id="mapa-infraestructura-asis-v3">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1240" pageHeight="820" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- TITULO PRINCIPAL -->
        <mxCell id="titulo" value="Mapa de Infraestructura Tecnológica (AS-IS) — Proceso de Logística de Encuesta de Autoevaluación&#10;Universidad de La Sabana · Vicerrectoría de Desarrollo (Coordinación de Experiencia y Servicio)" style="text;html=1;align=center;verticalAlign=middle;fontSize=15;fontStyle=1;fontColor=#1d2433;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="1160" height="45" as="geometry" />
        </mxCell>

        <!-- CAPA 1: SISTEMAS INSTITUCIONALES (ON-PREMISE / NUBE U. SABANA) -->
        <mxCell id="capa_institucional" value="Sistemas Institucionales (On-Premise / Infraestructura U. de La Sabana)" style="swimlane;whiteSpace=wrap;html=1;startSize=26;rounded=1;arcSize=4;fillColor=#eef2f7;strokeColor=#6c8ebf;strokeWidth=1.5;fontStyle=1;fontSize=12;verticalAlign=top;fontColor=#1d2433;" vertex="1" parent="1">
          <mxGeometry x="40" y="70" width="460" height="190" as="geometry" />
        </mxCell>
        <mxCell id="siga" value="⚠️ Sistema Académico (SIGA)&#10;[Instancia única institucional]&#10;Horarios, matrícula, programas y datos personales&#10;Fuente de verdad · Sin API pública de integración" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#c0392b;fontColor=#ffffff;strokeColor=#7b1f1f;strokeWidth=2;fontSize=11;fontStyle=1;" vertex="1" parent="capa_institucional">
          <mxGeometry x="20" y="45" width="260" height="85" as="geometry" />
        </mxCell>
        <mxCell id="db_siga" value="Base de Datos&#10;Académica (SIGA)&#10;[Clúster BD de TI]&#10;Alta disponibilidad interna&#10;Acceso directo restringido" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#dde3ea;strokeColor=#7f8c9a;fontSize=10;fontColor=#1d2433;" vertex="1" parent="capa_institucional">
          <mxGeometry x="305" y="45" width="135" height="85" as="geometry" />
        </mxCell>
        <mxCell id="nota_siga" value="Red de TI institucional (VLAN / Servidores corporativos)" style="text;html=1;fontSize=9;fontStyle=2;fontColor=#5b6475;align=center;" vertex="1" parent="capa_institucional">
          <mxGeometry x="20" y="145" width="420" height="20" as="geometry" />
        </mxCell>

        <!-- CAPA 2: NUBE MICROSOFT 365 (SAAS / TENANT INSTITUCIONAL) -->
        <mxCell id="capa_m365" value="Nube Microsoft 365 (SaaS / Tenant Institucional Universidad de La Sabana)" style="swimlane;whiteSpace=wrap;html=1;startSize=26;rounded=1;arcSize=4;fillColor=#f0f4fa;strokeColor=#2f5aa8;strokeWidth=1.5;fontStyle=1;fontSize=12;verticalAlign=top;fontColor=#1d2433;" vertex="1" parent="1">
          <mxGeometry x="530" y="70" width="670" height="190" as="geometry" />
        </mxCell>
        
        <!-- SUBZONA ONEDRIVE -->
        <mxCell id="sub_onedrive" value="OneDrive Institucional (Almacenamiento Cloud)" style="swimlane;whiteSpace=wrap;html=1;startSize=20;rounded=1;arcSize=6;fillColor=#ffffff;strokeColor=#2f5aa8;strokeWidth=1;fontSize=10;fontStyle=1;verticalAlign=top;fontColor=#2f5aa8;" vertex="1" parent="capa_m365">
