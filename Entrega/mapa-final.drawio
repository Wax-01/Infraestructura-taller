        <mxCell id="titulo" value="Mapa de Infraestructura (AS-IS) — Logística de la Encuesta de Autosatisfacción&#10;Universidad de La Sabana · Vicerrectoría de Desarrollo (Coordinación de Experiencia y Servicio)" style="text;html=1;align=center;verticalAlign=middle;fontSize=16;fontStyle=1;fontColor=#222222;" vertex="1" parent="1">
