        </mxCell>
        <mxCell id="excel_muestreo" value="⚠️ Hoja de Muestreo (Excel en OneDrive)&#10;[Instancia única sin respaldo automatizado]&#10;Muestreo por programa y semestre&#10;Riesgo H3: Sin control formal de versiones" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#c0392b;fontColor=#ffffff;strokeColor=#7b1f1f;strokeWidth=1.5;fontSize=10;fontStyle=1;" vertex="1" parent="sub_onedrive">
