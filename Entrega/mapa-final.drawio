        <mxCell id="zona_leyenda" value="Leyenda" style="swimlane;whiteSpace=wrap;html=1;startSize=24;rounded=1;arcSize=4;fillColor=#ffffff;strokeColor=#999999;fontStyle=1;fontSize=12;verticalAlign=top;" vertex="1" parent="1">
