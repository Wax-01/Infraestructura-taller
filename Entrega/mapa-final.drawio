        </mxCell>
        <mxCell id="pc_coordinadora" value="⚠️ PC / Portátil de Coordinación (Navegador Web + Excel Desktop)&#10;[Instancia única · Endpoint local único]&#10;Riesgo H6: Punto único de falla operativo y de conocimiento (dependencia total de una persona)&#10;Riesgo H2: Descarga de exportes CSV/Excel con datos personales (horarios, correos, nombres) sin auditoría centralizada" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff5e6;fontColor=#8c4a00;strokeColor=#b26a00;strokeWidth=2;fontSize=11;fontStyle=1;" vertex="1" parent="capa_endpoint">
          <mxGeometry x="20" y="40" width="590" height="90" as="geometry" />
        </mxCell>

