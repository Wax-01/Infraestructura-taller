        <!-- ACTOR: COORDINADORA -->
        <mxCell id="actor_coordinadora" value="Coordinadora de la Encuesta&#10;(Vicerrectoría de Desarrollo)&#10;[Actor de gestión y operación]&#10;Opera PC, arma muestra,&#10;asigna PAT y notifica" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#1d2433;" vertex="1" parent="1">
