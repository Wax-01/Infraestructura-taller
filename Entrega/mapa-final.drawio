        <mxCell id="siga" value="⚠️ SIGA (sistema académico institucional)&#10;Horarios, matrícula, programas y datos personales&#10;Fuente única · sin API de integración conocida (H1)&#10;[Redundancia: no confirmada — la administra TI]" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#c0392b;fontColor=#ffffff;strokeColor=#7b1f1f;strokeWidth=2;fontSize=11;fontStyle=1;" vertex="1" parent="zona_inst">
