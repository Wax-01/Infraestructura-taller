        </mxCell>

        <!-- CAPA 3: EQUIPO DE LA COORDINADORA (ENDPOINT LOCAL / ESTACION DE TRABAJO) -->
        <mxCell id="capa_endpoint" value="Equipo de la Coordinadora (Estación de Trabajo / Endpoint Local)" style="swimlane;whiteSpace=wrap;html=1;startSize=26;rounded=1;arcSize=4;fillColor=#fffbf0;strokeColor=#b26a00;strokeWidth=1.5;fontStyle=1;fontSize=12;verticalAlign=top;fontColor=#1d2433;" vertex="1" parent="1">
