        </mxCell>
        <mxCell id="leg7" value="Hallazgos (ver tabla del informe): H6 operadora única (Disponibilidad, Alta) · H3 hojas sin respaldo independiente (Disponibilidad, Alta) · H2 copias de datos personales fuera de SIGA (Seguridad de la información, Alta) · H4 cruce manual PAT (Rendimiento, Media) · H5 correo uno a uno (Rendimiento, Media) · H1 SIGA sin API (Escalabilidad, Media)" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontStyle=1;fontColor=#7b1f1f;whiteSpace=wrap;fillColor=#fff5e6;strokeColor=#b26a00;rounded=1;spacingLeft=8;" vertex="1" parent="zona_leyenda">
